{
  "name": "Lightweight Proxy CF",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "node",
  "postCreateCommand": "pnpm install --frozen-lockfile && pnpm build",
  "forwardPorts": [8787],
  "portsAttributes": {
    "8787": {
      "label": "Gateway (web and API)",
      "onAutoForward": "notify"
    }
  }
}
