{
  "name": "lightweight-proxy-example-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-28",
  "services": [
    {
      "binding": "WEB",
      "service": "lightweight-proxy-example-web"
    },
    {
      "binding": "API",
      "service": "lightweight-proxy-example-api"
    }
  ],
  "dev": {
    "ip": "127.0.0.1",
    "port": 8787,
    "inspector_port": 9230
  }
}
